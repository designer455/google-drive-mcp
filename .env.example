# Server Configuration
PORT=3000
NODE_ENV=production
ALLOWED_HOST=mcp.yourdomain.com
MCP_PUBLIC_ORIGIN=https://mcp.yourdomain.com
MCP_PUBLIC_URL=https://mcp.yourdomain.com/mcp

# Persistent Storage (must be outside deployment/version directories on production server)
DATA_DIR=/var/data/google-drive-mcp

# Credential Encryption at Rest (SEC-04: AES-256-GCM)
# REQUIRED in production. Must be a 32-byte (256-bit) cryptographically secure key.
# Generate with: openssl rand -base64 32
# WARNING: Keep this key secure and outside Git. If lost, encrypted credential stores cannot be decrypted!
# Format: Base64-encoded 32-byte string (e.g. 44 characters ending with '=')
STORAGE_ENCRYPTION_KEY=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://mcp.yourdomain.com/oauth2callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/documents

# Mode Configuration
# Set SINGLE_USER_MODE=true ONLY if this instance is for your private personal use
# and you want all sessions to share the single GOOGLE_REFRESH_TOKEN below.
# Default is false (multi-user mode): each user connects their own isolated Google account.
SINGLE_USER_MODE=false

# Persistent Storage Layer (Vercel Private Blob / AES-256-GCM)
# In production on Vercel, storage automatically uses Vercel Private Blob.
# Local development uses filesystem storage in ./data by default.
DATA_DIR=/google-drive-mcp-v2
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Single-User Permanent Serverless Connection (used ONLY when SINGLE_USER_MODE=true)
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_EMAIL=

# ChatGPT OAuth Configuration (MCP Authorization Server)
CHATGPT_OAUTH_CLIENT_ID=your-chatgpt-oauth-client-id
CHATGPT_OAUTH_CLIENT_SECRET=your-chatgpt-oauth-client-secret
CHATGPT_OAUTH_REDIRECT_URI=https://chatgpt.com/aip/g-example/oauth/callback

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX_REQUESTS=60
GOOGLE_API_TIMEOUT_MS=30000
GOOGLE_API_MAX_RETRIES=3
AUTH_CODE_EXPIRY_SECONDS=300
ACCESS_TOKEN_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_SECONDS=2592000
OAUTH_STATE_EXPIRY_SECONDS=600
OAUTH_GOOGLE_LINK_EXPIRY_SECONDS=600

# OpenAI Domain Verification (Required for OpenAI public plugin / directory submission)
OPENAI_APPS_CHALLENGE_TOKEN=

# Publisher & Support Information
SUPPORT_EMAIL=support@example.com
COMPANY_NAME=Google Drive MCP
COMPANY_WEBSITE=https://example.com
